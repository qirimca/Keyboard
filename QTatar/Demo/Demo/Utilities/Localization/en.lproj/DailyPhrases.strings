/* Daily & motivational phrases for the keyboard top suggestion bar (85 phrases). */
"phrase.1.text" = "Atalar sözünde altın bar.";
"phrase.1.attribution" = "Qırımtatar atalar sözü";
"phrase.1.translation" = "\"There is gold in the words of ancestors.\" (Crimean Tatar proverb)";
"phrase.2.text" = "Atalar sözü — aqılnıñ közü.";
"phrase.2.attribution" = "Qırımtatar atalar sözü";
"phrase.2.translation" = "\"The word of ancestors is the eye of the mind.\" (Crimean Tatar proverb)";
"phrase.3.text" = "Yahşı söz — can azığı.";
"phrase.3.attribution" = "Qırımtatar atalar sözü";
"phrase.3.translation" = "\"A kind word is nourishment for the soul.\" (Crimean Tatar proverb)";
"phrase.4.text" = "Til — aqıl terazesidir.";
"phrase.4.attribution" = "Qırımtatar atalar sözü";
"phrase.4.translation" = "\"Language is the scales of the mind.\" (Crimean Tatar proverb)";
"phrase.5.text" = "Til — yürekniñ anahtarı.";
"phrase.5.attribution" = "Qırımtatar atalar sözü";
"phrase.5.translation" = "\"Language is the key to the heart.\" (Crimean Tatar proverb)";
"phrase.6.text" = "Az ayt, naz ayt!";
"phrase.6.attribution" = "Qırımtatar atalar sözü";
"phrase.6.translation" = "\"Speak little, speak gracefully!\" (Crimean Tatar proverb)";
"phrase.7.text" = "Tilge ürmet — ilge ürmettir.";
"phrase.7.attribution" = "Qırımtatar atalar sözü";
"phrase.7.translation" = "\"Respect for the language is respect for the people.\" (Crimean Tatar proverb)";
"phrase.8.text" = "Sözüñnen işiñ bir olsun!";
"phrase.8.attribution" = "Qırımtatar atalar sözü";
"phrase.8.translation" = "\"Let your word and your deed be one!\" (Crimean Tatar proverb)";
"phrase.9.text" = "Kişiniñ sözünen işi bir olmalı.";
"phrase.9.attribution" = "Qırımtatar atalar sözü";
"phrase.9.translation" = "\"A person's word and deed must be one.\" (Crimean Tatar proverb)";
"phrase.10.text" = "Aqiqiy söz aqqan suvnı toqtatır.";
"phrase.10.attribution" = "Qırımtatar atalar sözü";
"phrase.10.translation" = "\"A true word stops even flowing water.\" (Crimean Tatar proverb)";
"phrase.11.text" = "İlim — aqıl çoqrağıdır.";
"phrase.11.attribution" = "Qırımtatar atalar sözü";
"phrase.11.translation" = "\"Knowledge is the spring of wisdom.\" (Crimean Tatar proverb)";
"phrase.12.text" = "Tatlı söz baldan tatlı.";
"phrase.12.attribution" = "Qırımtatar atalar sözü";
"phrase.12.translation" = "\"A sweet word is sweeter than honey.\" (Crimean Tatar proverb)";
"phrase.13.text" = "Ana tiliñ — baldan tatlı.";
"phrase.13.attribution" = "Qırımtatar atalar sözü";
"phrase.13.translation" = "\"Your mother tongue is sweeter than honey.\" (Crimean Tatar proverb)";
"phrase.14.text" = "Tiliñnen göñlüñ bir olmalı.";
"phrase.14.attribution" = "Qırımtatar atalar sözü";
"phrase.14.translation" = "\"Your tongue and your heart must be one.\" (Crimean Tatar proverb)";
"phrase.15.text" = "Göñlüñdeki — tiliñde.";
"phrase.15.attribution" = "Qırımtatar atalar sözü";
"phrase.15.translation" = "\"What is in the heart is on the tongue.\" (Crimean Tatar proverb)";
"phrase.16.text" = "Emek — ömürniñ zinetidir.";
"phrase.16.attribution" = "Qırımtatar atalar sözü";
"phrase.16.translation" = "\"Labor is the adornment of life.\" (Crimean Tatar proverb)";
"phrase.17.text" = "Birlik evde bereket bar.";
"phrase.17.attribution" = "Qırımtatar atalar sözü";
"phrase.17.translation" = "\"In a united home, there is abundance.\" (Crimean Tatar proverb)";
"phrase.18.text" = "Muabbetlik — baht anahtarı.";
"phrase.18.attribution" = "Qırımtatar atalar sözü";
"phrase.18.translation" = "\"Love and affection are the key to happiness.\" (Crimean Tatar proverb)";
"phrase.19.text" = "Tilini coyğan, Vatanını coyar.";
"phrase.19.attribution" = "Qırımtatar atalar sözü";
"phrase.19.translation" = "\"Whoever loses their language will lose their Homeland.\" (Crimean Tatar proverb)";
"phrase.20.text" = "Aşnıñ dadı — tuznen, adamnıñ dadı — söznen.";
"phrase.20.attribution" = "Qırımtatar atalar sözü";
"phrase.20.translation" = "\"The taste of food is in salt; the worth of a person is in words.\" (Crimean Tatar proverb)";
"phrase.21.text" = "Qulaq — eki, til — bir: eki diñle, bir söyle.";
"phrase.21.attribution" = "Qırımtatar atalar sözü";
"phrase.21.translation" = "\"Two ears, one tongue: listen twice, speak once.\" (Crimean Tatar proverb)";
"phrase.22.text" = "Tilni bilmek — dostluqnı qaviyleştirmektir.";
"phrase.22.attribution" = "Qırımtatar atalar sözü";
"phrase.22.translation" = "\"Knowing a language strengthens friendship.\" (Crimean Tatar proverb)";
"phrase.23.text" = "Bir filcan qaveniñ qırq yıl hatri bardır.";
"phrase.23.attribution" = "Qırımtatar atalar sözü";
"phrase.23.translation" = "\"A single cup of coffee is remembered for forty years.\" (Crimean Tatar proverb)";
"phrase.24.text" = "Ana tilim — canım-cigerim.";
"phrase.24.attribution" = "Dilâver Osman";
"phrase.24.translation" = "\"My native tongue is my heart and soul.\" (Dilâver Osman)";
"phrase.25.text" = "Ana tilim — halqnıñ temeli.";
"phrase.25.attribution" = "Dilâver Osman";
"phrase.25.translation" = "\"My native language is the foundation of the people.\" (Dilâver Osman)";
"phrase.26.text" = "Til — bizim temelimiz!";
"phrase.26.attribution" = "Seyran Üseinov";
"phrase.26.translation" = "\"Language is our foundation!\" (Seyran Üseinov)";
"phrase.27.text" = "Öz tilini bilsin er kes!";
"phrase.27.attribution" = "Seyran Üseinov";
"phrase.27.translation" = "\"Let everyone know their native language!\" (Seyran Üseinov)";
"phrase.28.text" = "Dünyada eñ tatlı — qırımtatar tilimiz!";
"phrase.28.attribution" = "Seyran Üseinov";
"phrase.28.translation" = "\"The sweetest in the world is our Crimean Tatar language!\" (Seyran Üseinov)";
"phrase.29.text" = "Sev tiliñni, sevgen kibi anañnı!";
"phrase.29.attribution" = "Eşref Şemi-zade";
"phrase.29.translation" = "\"Love your language as you love your mother!\" (Eşref Şemi-zade)";
"phrase.30.text" = "Tilimiz pek zengin eken!";
"phrase.30.attribution" = "Eşref Şemi-zade";
"phrase.30.translation" = "\"Our language is truly so rich!\" (Eşref Şemi-zade)";
"phrase.31.text" = "Sevdigim ana til — ruhumnıñ ğıdası.";
"phrase.31.attribution" = "Mambet Ablâlimov";
"phrase.31.translation" = "\"My beloved mother tongue is the nourishment of my spirit.\" (Mambet Ablâlimov)";
"phrase.32.text" = "Ana tili beşigimniñ yırı oldı.";
"phrase.32.attribution" = "Löman Suleyman";
"phrase.32.translation" = "\"The mother tongue became the song of my cradle.\" (Löman Suleyman)";
"phrase.33.text" = "Ana tilim — bu muabbetlik, sevgi sırı.";
"phrase.33.attribution" = "Löman Suleyman";
"phrase.33.translation" = "\"My mother tongue is affection and the secret of love.\" (Löman Suleyman)";
"phrase.34.text" = "Ana tili aenklidir, yımşaqtır.";
"phrase.34.attribution" = "Riza Halid";
"phrase.34.translation" = "\"The mother tongue is melodious and gentle.\" (Riza Halid)";
"phrase.35.text" = "Sen bar ekeç, men de barım!";
"phrase.35.attribution" = "Şeryan Ali";
"phrase.35.translation" = "\"As long as you live, O native tongue, I live too!\" (Şeryan Ali)";
"phrase.36.text" = "Tiliñni bil, oqu, yaz!";
"phrase.36.attribution" = "Vasfiye Qıpçaq";
"phrase.36.translation" = "\"Know your language, read, and write!\" (Vasfiye Qıpçaq)";
"phrase.37.text" = "Sırıñnı, yırıñnı şu tilde aytıñız!";
"phrase.37.attribution" = "Güner Aqmolla";
"phrase.37.translation" = "\"Share your secrets and your songs in this language!\" (Güner Aqmolla)";
"phrase.38.text" = "Çatırtav kibidir — bu Ana tilim!";
"phrase.38.attribution" = "Kerim Camanaqlı";
"phrase.38.translation" = "\"Like Chatyr-Dag is this Mother Tongue of mine!\" (Kerim Camanaqlı)";
"phrase.39.text" = "Oqup-yazam men bugün!";
"phrase.39.attribution" = "Seitümer Emin";
"phrase.39.translation" = "\"Today I read and write in my native tongue!\" (Seitümer Emin)";
"phrase.40.text" = "Yürekni ohşar tatlı sözleriñ!";
"phrase.40.attribution" = "Seitümer Emin";
"phrase.40.translation" = "\"Your sweet words caress the heart!\" (Seitümer Emin)";
"phrase.41.text" = "Tuvğan tilim! Güzel tilim!";
"phrase.41.attribution" = "Şakir Selim";
"phrase.41.translation" = "\"My native tongue! My beautiful tongue!\" (Şakir Selim)";
"phrase.42.text" = "Ne yapsañ yap, öz tiliñni unutma!";
"phrase.42.attribution" = "Refat Çaylaq";
"phrase.42.translation" = "\"Whatever you do, do not forget your native language!\" (Refat Çaylaq)";
"phrase.43.text" = "Elleriñiz dert körmesin!";
"phrase.43.attribution" = "";
"phrase.43.translation" = "May your hands never know pain!";
"phrase.44.text" = "Eliñe sağlıq!";
"phrase.44.attribution" = "";
"phrase.44.translation" = "Health to your hands!";
"phrase.45.text" = "Bergen el dert körmez.";
"phrase.45.attribution" = "Qırımtatar atalar sözü";
"phrase.45.translation" = "\"The hand that gives will know no pain.\" (Crimean Tatar proverb)";
"phrase.46.text" = "Ünerli qolda bereket bar.";
"phrase.46.attribution" = "Qırımtatar atalar sözü";
"phrase.46.translation" = "\"In skilled hands there is blessing and abundance.\" (Crimean Tatar proverb)";
"phrase.47.text" = "Ağzıñızdan bal tamlay!";
"phrase.47.attribution" = "";
"phrase.47.translation" = "Honey drips from your lips!";
"phrase.48.text" = "Körüşkenimiz ne de yahşı oldı!";
"phrase.48.attribution" = "";
"phrase.48.translation" = "How wonderful it is that we met!";
"phrase.49.text" = "Hoş sefa keldiñiz!";
"phrase.49.attribution" = "";
"phrase.49.translation" = "Welcome, we are glad you have come!";
"phrase.50.text" = "Saba şerfiñiz hayır olsun!";
"phrase.50.attribution" = "";
"phrase.50.translation" = "May your blessed morning be good!";
"phrase.51.text" = "Hayırlı sabalar olsun!";
"phrase.51.attribution" = "";
"phrase.51.translation" = "Good morning!";
"phrase.52.text" = "Künüñiz hayırlı olsun!";
"phrase.52.attribution" = "";
"phrase.52.translation" = "Have a good and blessed day!";
"phrase.53.text" = "Aqşam şerfiñiz hayır olsun!";
"phrase.53.attribution" = "";
"phrase.53.translation" = "May your blessed evening be good!";
"phrase.54.text" = "Geceler hayır!";
"phrase.54.attribution" = "";
"phrase.54.translation" = "Good night!";
"phrase.55.text" = "Şehr-u Ramazan, merhaba!";
"phrase.55.attribution" = "";
"phrase.55.translation" = "Welcome, O blessed month of Ramadan!";
"phrase.56.text" = "Oraza bayramıñız hayırlı olsun!";
"phrase.56.attribution" = "";
"phrase.56.translation" = "May your Oraza Bayram be blessed and joyful!";
"phrase.57.text" = "Qurban bayramıñız hayırlı olsun!";
"phrase.57.attribution" = "";
"phrase.57.translation" = "May your Qurban Bayram be blessed and joyful!";
"phrase.58.text" = "Cuma künüñiz mubarek olsun!";
"phrase.58.attribution" = "";
"phrase.58.translation" = "May your Friday be blessed!";
"phrase.59.text" = "Amet-Han — tillerde destansıñ!";
"phrase.59.attribution" = "Riza Fazıl";
"phrase.59.translation" = "\"Amet-Khan, on every tongue you are a legend!\" (Riza Fazıl)";
"phrase.60.text" = "Bu til maña — tolğun Ay!";
"phrase.60.attribution" = "Remzi Burnaş";
"phrase.60.translation" = "\"This language is a full Moon to me!\" (Remzi Burnaş)";
"phrase.61.text" = "Ant etkenmen yaranı sarmağa!";
"phrase.61.attribution" = "Noman Çelebicihan";
"phrase.61.translation" = "\"I have sworn to bind the wounds of my people!\" (Noman Çelebicihan)";
"phrase.62.text" = "Navrez keldi — yaz keldi!";
"phrase.62.attribution" = "Qırımtatar halq yırı";
"phrase.62.translation" = "\"Navrez has come—spring has arrived!\" (Crimean Tatar folk song)";
"phrase.63.text" = "Tilde, fikirde, işte — birlik!";
"phrase.63.attribution" = "İsmail Gasprinskiy";
"phrase.63.translation" = "\"Unity in language, in thought, and in action!\" (İsmail Gasprinskiy)";
"phrase.64.text" = "Kitap — bilgi anahtarı.";
"phrase.64.attribution" = "Qırımtatar atalar sözü";
"phrase.64.translation" = "\"A book is the key to knowledge.\" (Crimean Tatar proverb)";
"phrase.65.text" = "Közü yoq — körsete, sözü yoq — ögrete: Kitap.";
"phrase.65.attribution" = "Qırımtatar tapmacası";
"phrase.65.translation" = "\"Has no eyes yet shows, has no words yet teaches: A Book.\" (Crimean Tatar riddle)";
"phrase.66.text" = "Birlik olğan yerde tirlik bar.";
"phrase.66.attribution" = "Qırımtatar atalar sözü";
"phrase.66.translation" = "\"Where there is unity, there is life.\" (Crimean Tatar proverb)";
"phrase.67.text" = "Ana-babaña ürmet etseñ, özüñ ürmet körersiñ.";
"phrase.67.attribution" = "Qırımtatar atalar sözü";
"phrase.67.translation" = "\"Honor your mother and father, and you too will be honored.\" (Crimean Tatar proverb)";
"phrase.68.text" = "Qırım — menim Vatanımdır!";
"phrase.68.attribution" = "Çerkez-Ali";
"phrase.68.translation" = "\"Crimea is my native Homeland!\" (Çerkez-Ali)";
"phrase.69.text" = "Allah keçmişlerimizni rahmet eylesin!";
"phrase.69.attribution" = "";
"phrase.69.translation" = "May God have mercy on the souls of our departed ancestors!";
"phrase.70.text" = "Canımız-cigerimiz — balalar!";
"phrase.70.attribution" = "Remziye Tarsinova";
"phrase.70.translation" = "\"Our heart and soul are our children!\" (Remziye Tarsinova)";
"phrase.71.text" = "Milletniñ şanı — bayrağında!";
"phrase.71.attribution" = "Noman Çelebicihan";
"phrase.71.translation" = "\"The glory and honor of a nation are in its flag!\" (Noman Çelebicihan)";
"phrase.72.text" = "Oquvnı sevgen oqur, soñundan gülday qoqur.";
"phrase.72.attribution" = "Qırımtatar atalar sözü";
"phrase.72.translation" = "\"Who loves learning will study and later bloom like a rose.\" (Crimean Tatar proverb)";
"phrase.73.text" = "Baardeki areket — küzdeki bereket.";
"phrase.73.attribution" = "Qırımtatar atalar sözü";
"phrase.73.translation" = "\"Effort in spring brings abundance in autumn.\" (Crimean Tatar proverb)";
"phrase.74.text" = "Şegirt olmay, usta olmazsıñ.";
"phrase.74.attribution" = "Qırımtatar atalar sözü";
"phrase.74.translation" = "\"Without being an apprentice, you cannot become a master.\" (Crimean Tatar proverb)";
"phrase.75.text" = "İlim barda — qaruv bar.";
"phrase.75.attribution" = "Qırımtatar atalar sözü";
"phrase.75.translation" = "\"Where there is knowledge, there is strength.\" (Crimean Tatar proverb)";
"phrase.76.text" = "Öz tuvğan tilimde ayt mağa!";
"phrase.76.attribution" = "Bekir Çoban-zade";
"phrase.76.translation" = "\"Speak to me in my native tongue!\" (Bekir Çoban-zade)";
"phrase.77.text" = "Türkiy tiller gülzarınıñ fidanı!";
"phrase.77.attribution" = "Eşref Şemi-zade";
"phrase.77.translation" = "\"The sapling of the rose garden of Turkic languages!\" (Eşref Şemi-zade)";
"phrase.78.text" = "Terek tamırlarına tayanır, insan — tuvğanlarına.";
"phrase.78.attribution" = "Qırımtatar atalar sözü";
"phrase.78.translation" = "\"A tree relies on its roots; a person relies on their family.\" (Crimean Tatar proverb)";
"phrase.79.text" = "Yol köstergen Çolpan yıldızım!";
"phrase.79.attribution" = "Yunus Qandım";
"phrase.79.translation" = "\"My morning star Venus that shows the way!\" (Yunus Qandım)";
"phrase.80.text" = "İlim — insannıñ kemalıdır!";
"phrase.80.attribution" = "Üsein Şamil Tohtarğazı";
"phrase.80.translation" = "\"Knowledge is the perfection of humanity!\" (Üsein Şamil Tohtarğazı)";
"phrase.81.text" = "Amet-Han, köklerde Sultansıñ!";
"phrase.81.attribution" = "Riza Fazıl";
"phrase.81.translation" = "\"Amet-Khan, in the skies you are a Sultan!\" (Riza Fazıl)";
"phrase.82.text" = "Acayipsiñ, Ana tili!";
"phrase.82.attribution" = "İdris Asanin";
"phrase.82.translation" = "\"You are wonderful, Mother Tongue!\" (İdris Asanin)";
"phrase.83.text" = "İşiñiz oñ kelsin!";
"phrase.83.attribution" = "";
"phrase.83.translation" = "May your work go smoothly and succeed!";
"phrase.84.text" = "Vatan — ekinci anañ.";
"phrase.84.attribution" = "Qırımtatar atalar sözü";
"phrase.84.translation" = "\"The homeland is your second mother.\" (Crimean Tatar proverb)";
"phrase.85.text" = "Birlikte — quvet!";
"phrase.85.attribution" = "Qırımtatar atalar sözü";
"phrase.85.translation" = "\"In unity there is strength!\" (Crimean Tatar proverb)";
