    "scenes": [
      {
        "scene": 1,
        "act": "Welcome",
        "window_sec": "1-2",
        "crh": "QırımKey — Qırımtatar klaviaturası. Öz tilimiz — er yerde.",
        "uk": "QırımKey — Кримськотатарська клавіатура. Рідна мова — всюди.",
        "en": "QırımKey — Crimean Tatar Keyboard. Our language — everywhere."
      },
      {
        "scene": 2,
        "act": "Discovery",
        "window_sec": "3-6",
        "crh": "Qolay ve tez yazuv: Lâtin ve Kirill elifbeleri",
        "uk": "Зручний і швидкий набір: латиниця та кирилиця",
        "en": "Fast & natural typing: Latin and Cyrillic scripts"
      },
      {
        "scene": 3,
        "act": "Action",
        "window_sec": "7-10",
        "crh": "Aqıllı söz teklifleri, avto-tüzetüv ve svayp",
        "uk": "Розумні пропозиції слів, автовиправлення та свайп",
        "en": "Smart word suggestions, autocorrect & swipe-to-type"
      },
      {
        "scene": 4,
        "act": "Action",
        "window_sec": "11-14",
        "crh": "iPad imkânları: tam ekran ve yüzücü (Floating) rejim",
        "uk": "Можливості iPad: повноекранний і плаваючий (Floating) режим",
        "en": "iPad versatility: full-width Docked and Floating modes"
      },
      {
        "scene": 5,
        "act": "Action",
        "window_sec": "15-18",
        "crh": "Aydınlıq ve Qaranlıq tema, Ukraina ФІВА tizilişi",
        "uk": "Світла й темна теми, українська розкладка ФІВА",
        "en": "Light & Dark themes, Ukrainian FIVA layout"
      },
      {
        "scene": 6,
        "act": "Success",
        "window_sec": "19-22",
        "crh": "Tam hususiylik — 100% cihazda işley. App Store-dan indiriñiz!",
        "uk": "100% приватність — усі дані на пристрої. Завантажуйте в App Store!",
        "en": "100% on-device privacy. Download on the App Store!"
      }
    ]
  },
